{
  "hosting": {
    "site": "fzshift-sk",
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", ".git/**", "**/.*", "**/node_modules/**",
      "functions/**", "tools/**", "tests/**", "docs/**", "*.md", "*.log", "網址.txt",
      "package.json", "package-lock.json", "vitest.config.js", "playwright.config.js",
      "firestore.rules", "*.json", "!package.json"],
    "headers": [{ "source": "**/*.@(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "firestore": { "rules": "firestore.rules" }
}
